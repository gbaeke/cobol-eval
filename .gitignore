# Upstream clones. Both carry their own .git, so git would treat them as
# submodules rather than files — our changes to graphify live in
# extensions/graphify-cobol/ instead, and run.sh reapplies them to a fresh
# clone. spantree's local diff is only npm/build artifacts.
/spantree/
/gf/

# Toolchains and environments, all reproducible from run.sh / uv.
/node-v22.14.0-linux-x64/
node_modules/
.venv/
.venv-graphify/
__pycache__/
*.py[cod]

# run.sh step 3 re-fetches this working copy from aws-samples.
/carddemo/cbl/
/carddemo/cpy/

# NOT ignored: carddemo-graph/{cbl,cpy}. graphify reads .gitignore when it
# walks a tree, and only makes an exception for paths in git's index — so
# ignoring the graph's own input silently yields "No code files found" and a
# graph with zero programs in it. Tracked on purpose. Apache-2.0, see README.

# Generated: grammar sources pulled from upstream, compiled parsers, graph output.
/cobol/src/
/cobol/*.so
/pywheel/src/
/pywheel/build/
/pywheel/*.egg-info/
*.so
*.o
/carddemo-graph/graphify-out/

# Run logs and scratch output.
*.log
compare.err

# Secrets — nothing here today, and it stays that way.
.env
.env.*
*.pem
*.key
config.yaml
