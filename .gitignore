# Upstream clones. Both carry their own .git, so git would treat them as
# submodules rather than files — our changes to graphify live in
# extensions/graphify-cobol/ instead, and run.sh reapplies them to a fresh
# clone. spantree's local diff is only npm/build artifacts.
/spantree/
/gf/

# Toolchains and environments, all reproducible from run.sh / uv.
/node-v22.14.0-linux-x64/
node_modules/
.venv/
.venv-graphify/
__pycache__/
*.py[cod]

# Downloaded corpora (run.sh step 3 fetches these from aws-samples).
/carddemo/cbl/
/carddemo/cpy/
/carddemo-graph/cbl/
/carddemo-graph/cpy/

# Generated: grammar sources pulled from upstream, compiled parsers, graph output.
/cobol/src/
/cobol/*.so
/pywheel/src/
/pywheel/build/
/pywheel/*.egg-info/
*.so
*.o
/carddemo-graph/graphify-out/

# Run logs and scratch output.
*.log
compare.err

# Secrets — nothing here today, and it stays that way.
.env
.env.*
*.pem
*.key
config.yaml
